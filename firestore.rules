rules_version = '2';

// =============================================================================
// Zupurb — Firestore Security Rules
// Version: B1 (foundation)
//
// Philosophy:
//   - Default deny: no collection is readable or writable unless explicitly
//     granted below.
//   - Client writes are only allowed for harmless user-controlled state.
//   - All scoring, points, UAR, tier, badge, verification, and fraud signals
//     are written exclusively by Cloud Functions via the Admin SDK (which
//     bypasses these rules entirely — Admin SDK writes are always trusted).
//   - App Check is enforced at the callable layer; these rules add a second
//     layer of defence for any direct SDK access.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    // Check that the caller is a participant in a conversation.
    // threadData must be the conversation document data.
    function isParticipant(threadData) {
      return request.auth != null
        && request.auth.uid in threadData.participantUids;
    }

    // Validate that incoming data only sets allowed fields (no extra fields).
    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Ensure the calling user is not banned.
    // Used on write rules for reviews, messages, and reports.
    // Returns true (allow) when the isBanned field is absent or false.
    // Cloud Functions enforce this at the callable layer as well.
    function isNotBanned() {
      return !('isBanned' in resource.data) || resource.data.isBanned == false;
    }

    // -------------------------------------------------------------------------
    // COLLECTION: users/{userId}
    //
    // - Owner: read own document (full); limited write (bio, privacyToggles, etc.)
    // - Authenticated users: read public fields only; deleted accounts not readable
    // - Admin: read + write
    //
    // NOTE: accountStatus=deleted documents are blocked from non-admin reads.
    //       Cloud Function soft-delete sets isDeleted=true before returning;
    //       these rules provide a second layer of defense.
    // -------------------------------------------------------------------------

    // Helper: returns true if the document is soft-deleted (PII already wiped)
    function isDeletedUser(data) {
      return data != null && data.isDeleted == true;
    }

    match /users/{userId} {
      // Owner can always read their own doc; authenticated users can read
      // only if the account is not soft-deleted.
      allow read: if isOwner(userId)
        || (isAuthenticated() && !isDeletedUser(resource.data));
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;
      // Client can only update the safe subset of their own profile.
      // Plus subscription fields (isPlusSubscriber, plusExpiresAt, plusActive,
      // plusActivatedAt, plusActiveUntil, plusSource) are intentionally absent
      // from this list — they are written exclusively by Cloud Functions via
      // Admin SDK (RevenueCat webhook, processPlusExpirations cron).
      allow update: if isOwner(userId)
        && hasOnly([
          "displayName",
          "photoUrl",
          "bio",
          "tierHiddenByUser",
          "onboardingComplete",
          "dateOfBirth",   // B14: user sets MM-DD for birthday bonus eligibility
          "updatedAt"
        ]);
      allow delete: if false; // Deletion handled by Cloud Function (anonymize, not delete)
      // Admin override (Retool / Admin SDK path)
      allow read, write: if isAdmin();

      // -----------------------------------------------------------------------
      // SUB-COLLECTION: users/{userId}/fingerprintSnapshots/{snapshotId}
      // Written once by Cloud Function at review submission. Never client-readable.
      // -----------------------------------------------------------------------
      match /fingerprintSnapshots/{snapshotId} {
        allow read: if isAdmin();
        allow write: if false; // Cloud Function writes via Admin SDK only
      }

      // -----------------------------------------------------------------------
      // SUB-COLLECTION: users/{userId}/referrals/{referralId}
      // Owner can read their own outbound referrals; Cloud Function writes.
      // -----------------------------------------------------------------------
      match /referrals/{referralId} {
        allow read: if isOwner(userId);
        allow write: if false; // Cloud Function writes via Admin SDK only
      }
    }

    // -------------------------------------------------------------------------
    // COLLECTION: private_user_data/{userId}
    //
    // Admin-only reads and writes. Absolutely no client access.
    // Cloud Functions use Admin SDK which bypasses these rules.
    // -------------------------------------------------------------------------

    match /private_user_data/{userId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: establishments/{estId}
    //
    // - Authenticated users: read
    // - Admin: read + write
    // - Claimed business owners can update limited fields (via callable CF;
    //   direct write restricted to admin here for defence-in-depth)
    // -------------------------------------------------------------------------

    match /establishments/{estId} {
      allow read: if true;  // public read for Phase 1B data wiring
      allow create, update, delete: if isAdmin();

      // -----------------------------------------------------------------------
      // SUB-COLLECTION: establishments/{estId}/reviews/{reviewId}
      // Denormalized review copies. Written by Cloud Function only.
      // Readable by authenticated users (same as flat reviews collection).
      // -----------------------------------------------------------------------
      match /reviews/{reviewId} {
        allow read: if true;  // public read for Phase 1B data wiring
        allow create: if request.auth != null;
        allow update, delete: if false; // Cloud Function writes via Admin SDK only
      }

      // -----------------------------------------------------------------------
      // SUB-COLLECTION: establishments/{estId}/reservationSlots/{slotId}
      // Readable by authenticated users; written by admin/CF only.
      // -----------------------------------------------------------------------
      match /reservationSlots/{slotId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // -----------------------------------------------------------------------
      // SUB-COLLECTION: establishments/{estId}/deals/{dealId}
      // Readable by authenticated users; admin-write only.
      // -----------------------------------------------------------------------
      match /deals/{dealId} {
        allow read: if true;  // public read for Phase 1B data wiring
        allow write: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // COLLECTION: reviews/{reviewId}
    //
    // - Authenticated users: read published reviews
    // - Author: create (via callable CF enforces all validation; direct path
    //   kept here as fallback with minimal field validation)
    // - Update: blocked client-side once verifiedAt is set (immutable after
    //   verification). Cloud Function can still update via Admin SDK.
    // - Admin: full access
    // -------------------------------------------------------------------------

    match /reviews/{reviewId} {
      allow read: if true;  // public read for Phase 1B data wiring — published filter applied in query

      allow create: if isOwner(request.resource.data.authorUid)
        // Banned users cannot write reviews (B12)
        && isNotBanned()
        // answers array must have exactly 8 elements (Q1–Q8)
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 8
        // status must start as "pending" or "draft"; never "published" from client
        && request.resource.data.status in ["pending", "draft"]
        // client must NOT set score fields (they are set by CF)
        && !("rawScore" in request.resource.data)
        && !("weightFactor" in request.resource.data)
        && !("uarAtSubmission" in request.resource.data)
        // B3: client must NOT set sandbox / quarantine / fraud fields — CF Admin SDK only
        && !("sandboxed" in request.resource.data)
        && !("quarantined" in request.resource.data)
        && !("quarantineReason" in request.resource.data)
        && !("quarantinedAt" in request.resource.data)
        && !("isFraudFlagged" in request.resource.data)
        && !("isAnomalous" in request.resource.data)
        && !("hasQ8Contradiction" in request.resource.data)
        && !("isCoordinatedAttack" in request.resource.data);

      allow update: if isOwner(resource.data.authorUid)
        // Once verifiedAt is set, the document is immutable to the client
        && resource.data.verifiedAt == null
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.estId == resource.data.estId
        // Client may only update safe fields
        // B3: sandboxed / quarantined / fraud fields are NOT in this list —
        //     they can only be written by Cloud Functions via Admin SDK.
        && hasOnly([
          "title",
          "body",
          "disclosureCategory",
          "mediaIds",
          "status",
          "updatedAt"
        ]);

      allow delete: if false; // Soft-delete only; Cloud Function sets status="removed"

      allow read, write: if isAdmin();

      // -----------------------------------------------------------------------
      // SUB-COLLECTION: reviews/{reviewId}/votes/{voterUid}
      // Authenticated users can cast/change their own vote.
      // -----------------------------------------------------------------------
      match /votes/{voterUid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(voterUid)
          && request.resource.data.voterUid == voterUid
          && request.resource.data.vote in ["up", "down"];
        allow delete: if isOwner(voterUid);
      }
    }

    // -------------------------------------------------------------------------
    // COLLECTION: pointsLedger/{entryId}  (append-only)
    //
    // B6: All writes are server-only (Cloud Functions via Admin SDK).
    //     Client receives balance/history only through the getWallet callable.
    //
    // - Owner (userId == request.auth.uid): read own entries
    // - Create / Update / Delete: NEVER from client — Admin SDK only
    // - Admin: read all entries (for support / audit)
    // -------------------------------------------------------------------------

    match /pointsLedger/{entryId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if false;  // Cloud Function writes via Admin SDK only (B6)
      allow read: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: userBalances/{userId}
    //
    // - Owner: read only (written by Cloud Function only)
    // -------------------------------------------------------------------------

    match /userBalances/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: badges/{badgeId}  (global definitions)
    //
    // - Authenticated users: read (to display badge catalogue)
    // - Admin: write
    // -------------------------------------------------------------------------

    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: userBadges/{userId}/badges/{badgeId}
    //
    // - Owner: read
    // - Authenticated users: read (for viewing other profiles)
    // - Write: Cloud Function only (Admin SDK)
    // -------------------------------------------------------------------------

    match /userBadges/{userId}/badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: challenges/{challengeId}
    //
    // - Authenticated users: read active challenges
    // - Admin: write
    // -------------------------------------------------------------------------

    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && resource.data.isActive == true;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: userChallengeProgress/{compositeId}
    //
    // - Owner: read their own progress
    // - Write: Cloud Function only
    // -------------------------------------------------------------------------

    match /userChallengeProgress/{compositeId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: reservations/{reservationId}
    //
    // B8 rules:
    //   - Guest (guestUid): read own reservation doc (but NOT sensitive fields —
    //     checkInQrCode, checkInOtpHash, otpExpiresAt are server-write-only).
    //     Reads return the whole doc; sensitive fields must be stripped in
    //     the getMyReservations callable before returning to the client.
    //   - Establishment owners (staff claim): read reservations for their venue.
    //   - Admin: full read + write.
    //   - Create / Update / Delete: Cloud Functions via Admin SDK ONLY.
    //     No direct client write path — callable enforces all validation.
    // -------------------------------------------------------------------------

    match /reservations/{reservationId} {
      // Owner read (guest) or establishment staff or admin
      allow read: if isAuthenticated()
        && (
          resource.data.guestUid == request.auth.uid
          || isAdmin()
          || isStaff()
        );

      // All writes are Admin SDK only (callable functions).
      // Direct client create/update/delete is blocked for defense-in-depth.
      // The callable layer enforces slot availability, 48h cancel policy,
      // QR/OTP generation, and status transitions.
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Admin override — Retool / Admin SDK path
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: conversations/{conversationId}
    //
    // - Participants only: read
    // - Create: authenticated caller must be in participantUids
    // - Update: ONLY the metadata fields that Cloud Functions legitimately
    //   write via the client SDK path (lastMessageText, unreadCounts, etc.).
    //   All other mutations (businessInitiatedMessageCount, lastRepliedByUid,
    //   conversationType) must go through Cloud Functions via Admin SDK.
    // - Admin: full access for moderation
    // -------------------------------------------------------------------------

    match /conversations/{conversationId} {
      allow read: if isAuthenticated()
        && isParticipant(resource.data);
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantUids;
      // Client-side updates restricted to safe metadata fields only.
      // Score, UAR, business gate fields are Admin SDK–only writes.
      allow update: if isAuthenticated()
        && isParticipant(resource.data)
        && hasOnly([
          "lastMessageText",
          "lastMessageAt",
          "lastMessageSenderUid",
          "unreadCounts",
          "updatedAt"
        ]);
      allow delete: if false;
      allow read, write: if isAdmin();

      // -----------------------------------------------------------------------
      // SUB-COLLECTION: conversations/{conversationId}/messages/{messageId}
      //
      // - Read:   participant only
      // - Create: participant + senderUid must equal caller uid
      // - Update: NOT allowed from client (soft-delete and moderation go through
      //           Cloud Functions via Admin SDK)
      // - Delete: never (soft delete only)
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if isAuthenticated()
          && request.resource.data.senderUid == request.auth.uid
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          // Banned users cannot send messages (B12)
          && isNotBanned();
        // No client-side updates — soft-delete and moderation go through Cloud Functions
        allow update: if false;
        allow delete: if false;
        allow read, write: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // COLLECTION: notifications/{userId}/items/{notifId}
    //
    // - Owner: read; update (mark as read only)
    // - Write: Cloud Function only
    // -------------------------------------------------------------------------

    match /notifications/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId)
        && hasOnly(["isRead", "readAt"]);
      allow create, delete: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: deals/{dealId}
    //
    // - Authenticated users: read active deals
    // - Admin: write
    // -------------------------------------------------------------------------

    match /deals/{dealId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: dealRedemptions/{redemptionId}  (append-only)
    //
    // - Owner: read their own redemptions
    // - Write: Cloud Function only (Admin SDK)
    // -------------------------------------------------------------------------

    match /dealRedemptions/{redemptionId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: referralCodes/{code}
    //
    // - Authenticated users: read (to validate a referral code at sign-up)
    // - Write: Cloud Function only
    // -------------------------------------------------------------------------

    match /referralCodes/{code} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: referrals/{referralId}   (B13 — flat attribution log)
    //
    // - Referrer and referee can read their own referral doc.
    // - Write: Cloud Function only (Admin SDK bypasses rules).
    // - Admin: full read + write.
    // -------------------------------------------------------------------------

    match /referrals/{referralId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.referrerUid
            || request.auth.uid == resource.data.refereeUid);
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: posts/{postId}
    //
    // - Authenticated users: read active posts
    // - Author: create; update limited fields; soft-delete (isActive = false)
    // -------------------------------------------------------------------------

    match /posts/{postId} {
      allow read: if isAuthenticated()
        && (resource.data.isActive == true || isOwner(resource.data.authorUid));
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isOwner(resource.data.authorUid)
        && hasOnly(["caption", "isActive", "updatedAt"]);
      allow delete: if false;
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: flags/{flagId}  (content reports)
    //
    // - Authenticated users: create a flag
    // - Admin: read + update (triage)
    // -------------------------------------------------------------------------

    match /flags/{flagId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "open"
        // Banned users cannot file reports (B12)
        && isNotBanned();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // COLLECTION: reportedContent/{rid}  (B12 content report pipeline)
    //
    // - Authenticated users: create (callable enforces rate limit + ban check)
    // - Admin/staff: read + update (triage and resolve)
    // -------------------------------------------------------------------------

    match /reportedContent/{rid} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterUid == request.auth.uid
        // Banned users cannot submit reports (B12)
        && isNotBanned();
      allow read, update: if isAdmin() || isStaff();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // COLLECTION: claimRequests/{requestId}
    //
    // B4: Business claiming workflow.
    //
    // - Authenticated users: create (own uid only) + read own requests
    // - Admins: read + write all (approve / reject)
    // - Updates: only via Cloud Function (Admin SDK) or admin; never by the
    //   claimant (status transitions are server-side only)
    // -------------------------------------------------------------------------

    match /claimRequests/{requestId} {
      // Claimant can read their own requests; admin reads all.
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid)
        || isAdmin();

      // Authenticated users may create a claim request for themselves only.
      // Status must start as "pending"; reviewedBy and reviewNotes must be null.
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewNotes == null;

      // Update and delete are admin-only (approve / reject transitions).
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: adminQueue/{queueItemId}
    //
    // - Authenticated users: create only (for user-submitted flags / reports)
    //   Server enforces ban check and rate limits via the callable layer.
    //   Direct client creates are gated: status must be 'pending', no assignedTo.
    // - Admin/staff: read + write (triage, resolve, escalate — Retool / Admin SDK)
    // -------------------------------------------------------------------------

    match /adminQueue/{queueItemId} {
      // Authenticated users may create a queue item for content flagging.
      // The callable (flagReviewForModeration) is the intended path; this rule
      // provides a defence-in-depth fallback for direct SDK access.
      allow create: if isAuthenticated()
        && request.resource.data.status == "pending"
        && request.resource.data.assignedTo == null
        // Banned users cannot submit flags
        && isNotBanned();
      allow read, write: if isAdmin() || isStaff();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: establishmentScores/{estId}
    //
    // - Authenticated users: read (displayed on establishment page)
    // - Write: Cloud Function only (Admin SDK)
    // -------------------------------------------------------------------------

    match /establishmentScores/{estId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: _scheduled_deletes/{uid}
    //
    // Written by deleteAccount Cloud Function (Admin SDK).
    // No client access — Admin SDK bypasses these rules.
    // Admin can read for ops/support visibility.
    // -------------------------------------------------------------------------

    match /_scheduled_deletes/{uid} {
      allow read, write: if false;  // Cloud Function + Admin SDK only
      allow read: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: plusSubscriptions/{uid}
    //
    // B11: Stores the full RevenueCat subscription document for a user.
    //
    // - Owner: read only (view own subscription state)
    // - Write: Cloud Function only (Admin SDK — RevenueCat webhook handler)
    //   No direct client writes are permitted.
    // - Admin: full access for support / audit
    // -------------------------------------------------------------------------

    match /plusSubscriptions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: follows/{followId}  (B10 — follow graph)
    //
    // Document ID format: "{followerId}__{followeeId}"
    //
    // - Authenticated create: caller must be the followerId (own follow)
    // - Authenticated delete: caller must be the followerId (own unfollow)
    // - Public read: any authenticated user (profile page follow counts, gate checks)
    // - Update: never — create or delete only
    // -------------------------------------------------------------------------

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.followerId == request.auth.uid
        && followId == request.resource.data.followerId + "__" + request.resource.data.followeeId;
      allow delete: if isAuthenticated()
        && resource.data.followerId == request.auth.uid;
      allow update: if false; // immutable
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: userTiers/{uid}  (B14 — Loyalty Tier state)
    //
    // Dedicated tier document: current tier, rolling 12-month points cache,
    // last transition info, next evaluation date, inactivity tracking.
    //
    // - Owner: read only (their own tier data)
    // - Write: Cloud Function only (Admin SDK — tier engine, quarterly cron)
    // - Admin: full access for support / audit
    // -------------------------------------------------------------------------

    match /userTiers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // SUB-COLLECTION: users/{userId}/tierHistory/{eventId}
    //
    // Tier transition history. Written by handleTierTransition in lib/tiers.ts.
    //
    // - Owner: read only
    // - Write: Cloud Function only (Admin SDK)
    // - Admin: full access
    // -------------------------------------------------------------------------

    match /users/{userId}/tierHistory/{eventId} {
      allow read: if isOwner(userId);
      allow write: if false; // Cloud Function writes via Admin SDK only
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: giftCardRedemptions/{uid}/redemptions/{redemptionId}
    //
    // I7: Gift card redemption records. Subcollection per user.
    //
    // - Owner: read own redemption history
    // - Write: Cloud Function only (Admin SDK) — redeemGiftCard callable
    // - Admin: full access for support / audit
    // -------------------------------------------------------------------------

    match /giftCardRedemptions/{uid}/redemptions/{redemptionId} {
      allow read: if isOwner(uid);
      allow write: if false; // Cloud Function writes via Admin SDK only (I7)
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Catch-all: deny everything not explicitly matched above.
    // This is the default, but being explicit aids readability.
    // -------------------------------------------------------------------------

  }
}
